DATABASE_URL=postgresql+psycopg://facerec:facerec@localhost:5432/facerec
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=faces
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_ROOT=/models
MATCH_THRESHOLD=0.42
REVIEW_THRESHOLD=0.32
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=900
RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_TOP_K=20
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-different-random-secret
OTP_DELIVERY_MODE=development
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFICATION_ATTEMPTS=5
MEETING_CODE_SECRET=replace-with-a-third-random-secret
MEETING_CODE_TTL_SECONDS=900
