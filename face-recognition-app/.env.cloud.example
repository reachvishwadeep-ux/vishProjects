API_DOMAIN=api.example.com
MEDIA_DOMAIN=media.example.com

POSTGRES_USER=facerec
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
POSTGRES_DB=facerec

MINIO_ROOT_USER=replace-with-a-random-alphanumeric-access-key
MINIO_ROOT_PASSWORD=replace-with-a-random-alphanumeric-secret-key
S3_BUCKET=faces

INSIGHTFACE_MODEL=buffalo_l
MATCH_THRESHOLD=0.42
REVIEW_THRESHOLD=0.32
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=900
RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_TOP_K=20

JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-different-random-secret
OTP_DELIVERY_MODE=telnyx_verify
TELNYX_API_KEY=
TELNYX_VERIFY_PROFILE_ID=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFICATION_ATTEMPTS=5

MEETING_CODE_SECRET=replace-with-a-third-random-secret
MEETING_CODE_TTL_SECONDS=900
AUDIT_ADMIN_KEY=replace-with-a-fourth-random-secret
AUDIT_UPLOAD_BURST_LIMIT=5
AUDIT_FAILED_ACTION_LIMIT=3
AUDIT_MAX_INSTALLATIONS_PER_ACCOUNT=3
AUDIT_RETENTION_DAYS=365
AUDIT_INSTALLATION_INACTIVITY_DAYS=365
